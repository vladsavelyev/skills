#!/bin/sh
# PreToolUse hook on Bash. It runs before every Bash command of every session, so only a command
# that mentions a merge pays for Python; ship's src/ship/merge_guard.py parses it properly.
input=$(cat)
case "$input" in
*merge*) printf '%s' "$input" | exec uv run --quiet --frozen --no-dev --project "$(dirname "$0")/.." feature-merge-guard "$@" ;;
esac
