{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/feature-session-context\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/feature-stop-hook\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__t3-code__pull_request_merge",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/feature-merge-guard\""
          }
        ]
      }
    ]
  }
}
